# Local Ollama is the default and requires no cloud credentials.
APP_ENV=development
# Set exact DNS names/IP hosts for the API when deploying (example: ai.example.internal,10.0.0.5).
TRUSTED_HOSTS=
AUTH_DATABASE_PATH=./data/auth.sqlite3
# Optional Supabase Postgres connection string. When set, the API uses Supabase for account storage instead of SQLite.
AUTH_DATABASE_URL=
APP_WEB_URL=http://localhost:3000
# Brevo password-reset email. The sender email/domain must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=V-Sutra
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Browser origin allowlist, comma-separated.
FRONTEND_ORIGINS=http://localhost:3000

# Per-process request limits. Keep the API bound to localhost unless deployed behind a
# trusted reverse proxy with its own rate limiting and request-size enforcement.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_REQUESTS=120
RATE_LIMIT_CHAT_REQUESTS=12
RATE_LIMIT_UPLOAD_REQUESTS=10
MAX_REQUEST_BODY_MB=128
MAX_CONCURRENT_INFERENCE_REQUESTS=2

# Optional DeepSeek. No remote request happens unless a DeepSeek model is selected.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
DEEPSEEK_MODEL_CONTEXT_WINDOWS=

# Optional Mistral. This adapter uses the provider's documented OpenAI-compatible route.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_MODELS=mistral-small-latest,mistral-large-latest
MISTRAL_MODEL_CONTEXT_WINDOWS=

# Optional Bedrock. Set model IDs explicitly and configure AWS credentials through the SDK chain.
# No Bedrock service requests are made until a Bedrock model is selected for chat.
BEDROCK_REGION=
BEDROCK_MODELS=
BEDROCK_MODEL_CONTEXT_WINDOWS=

# Optional OpenAI-compatible custom server. API key can be blank for a trusted private endpoint.
CUSTOM_MODEL_NAME=
CUSTOM_MODEL_ID=custom-model
CUSTOM_MODEL_BASE_URL=
CUSTOM_MODEL_API_KEY=
CUSTOM_MODEL_CONTEXT_WINDOW=
CUSTOM_MODEL_CAPABILITIES=chat,streaming

# Tool calling. Tools are off unless enabled per request by the user.
TOOLS_MAX_ROUNDS=4
TOOL_CONFIRMATION_TIMEOUT_SECONDS=120
TOOL_MAX_RESULT_CHARS=12000

# Optional web search. Choose brave, tavily, searxng, or none.
# Search results are real external network responses; never enable implicitly.
SEARCH_PROVIDER=none
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=15
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SEARXNG_BASE_URL=

# Sandboxed code execution. Container-only; never falls back to the host.
# Install Docker or Podman and pull the images before enabling.
SANDBOX_ENABLED=true
SANDBOX_ENGINE=auto
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_MAX_OUTPUT_BYTES=20000
SANDBOX_MAX_CODE_CHARS=20000
SANDBOX_MAX_STDIN_CHARS=10000
SANDBOX_PYTHON_IMAGE=python:3.12-alpine
SANDBOX_JAVASCRIPT_IMAGE=node:22-alpine

# Voice engines. Browser speech works with no settings.
# Set STT to whisper_compatible for a local whisper.cpp/OpenAI-compatible server.
VOICE_STT_PROVIDER=none
VOICE_STT_BASE_URL=
VOICE_STT_API_KEY=
VOICE_STT_MODEL=whisper-1
VOICE_STT_TIMEOUT_SECONDS=60
VOICE_TTS_PROVIDER=browser
VOICE_TTS_BASE_URL=
VOICE_TTS_API_KEY=
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy
VOICE_TTS_FORMAT=mp3
VOICE_MAX_UPLOAD_MB=25
VOICE_MAX_TEXT_CHARS=4000
