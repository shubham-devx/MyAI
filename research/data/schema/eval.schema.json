{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v-sutra.local/schemas/eval.schema.json",
  "title": "V-Sutra evaluation case",
  "description": "One JSONL evaluation case. Expected checks are scored deterministically by the research workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "prompt", "expected"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 12000},
    "system": {"type": "string", "maxLength": 4000},
    "tags": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 32}
    },
    "max_tokens": {"type": "integer", "minimum": 1, "maximum": 8192},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["exact", "contains", "not_contains", "regex", "json_schema", "tool_call", "rubric"]
        },
        "value": {
          "type": ["string", "array"],
          "items": {"type": "string", "minLength": 1, "maxLength": 4000},
          "maxItems": 20
        },
        "schema": {"type": "object"},
        "tool": {"type": "string", "minLength": 1, "maxLength": 64},
        "arguments": {"type": "object"},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 32},
              "description": {"type": "string", "minLength": 1, "maxLength": 500},
              "weight": {"type": "number", "minimum": 0, "maximum": 10}
            }
          }
        }
      }
    }
  }
}
